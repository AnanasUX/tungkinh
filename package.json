{
  "name": "tungkinh",
  "version": "1.0.0",
  "description": "> Không gian tâm linh thanh tịnh, trang nghiêm dành cho Phật tử và hành giả tu tập trực tuyến: Gõ Mõ, Thỉnh Đại Hồng Chung, Tụng Kinh Tự Động, Dâng Hương, Đảnh Lễ và Tích Lũy Công Đức.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "esbuild src/app/(frontend)/entry.tsx --bundle --minify --outfile=dist/app.bundle.js --format=esm --target=es2022",
    "test": "node --check server.js && node --check js/realtime-sanctuary.js && node --check js/room-chat.js"
  },
