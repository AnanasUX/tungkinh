# LiveKit API Key
LIVEKIT_API_KEY=your_livekit_api_key_here
# LiveKit API Secret (CHỈ DÙNG PHÍA SERVER ĐỂ KÝ ACCESS TOKEN CHO NGƯỜI DÙNG)
